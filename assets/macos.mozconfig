# export CXX="$CROSS/clang/bin/clang++"
# export HOST_CC="$CROSS/clang/bin/clang"
# export HOST_CXX="$CROSS/cla   ng/bin/clang++"

# Use the runner's preinstalled Xcode SDK so `./mach bootstrap` does not
# try to download MacOSX*.sdk from the Mozilla Taskcluster CDN (returns
# 403 for non-Mozilla CI). Required on GitHub macOS runners.
if command -v xcrun >/dev/null 2>&1; then
    ac_add_options --with-macos-sdk="$(xcrun --show-sdk-path)"
fi
