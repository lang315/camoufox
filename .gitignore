/browser/bundle/fonts/extra

# The font bundle is a release asset, not repo content: ~2.1 GB extracted,
# ~770 MB as .tar.xz, and an xz archive cannot be delta-compressed, so tracking
# it would append the whole thing to history on every font change. It is pinned
# by browser/scripts/data/font-bundle.json (asset name + size + sha256) and
# fetched with `make fetch-fonts`. Only the compressed archive is kept;
# browser/bundle/fonts/ is extracted on demand.
/browser/bundle/fonts/
/browser/bundle/fonts-bundle-*.tar.xz
/browser/bundle/*.tar.xz.part
/browser/bundle/langpacks/
python/*.png
browser/scripts/*.png
browser/scripts/test*
.vscode
.idea
/browser/tests/playwright/*.disabled
camoufox-*.*.*/

