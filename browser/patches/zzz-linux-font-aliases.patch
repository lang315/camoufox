+#ifndef MOZ_WIDGET_GTK
+#  include "FontAliasesLinux.hpp"
+
+static MaskConfig::SpoofedOS SystemUISpoofedOS(
+    FontVisibilityProvider* aFontVisibilityProvider);
+
+// Camoufox (#325): the Linux faces fontconfig substitutes for a name no Linux
+// face carries (FontAliasesLinux.hpp, generated from fonts.conf). A Linux claim
+// on a host without fontconfig has to apply them itself.
+static const char* const* CamouLinuxAliasTargets(const nsACString& aKey) {
+  for (const CamouFontAlias* alias = kCamouLinuxAliases; alias->name; ++alias) {
+    if (aKey.EqualsASCII(alias->name)) {
+      return alias->targets;
+    }
+  }
+  return nullptr;
+}
+#endif
