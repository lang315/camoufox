+        const nsDependentCString target(*targets);
+        if (CamouLinuxAliasTargets(target)) {
+          continue;  // a key as a target would recurse for ever
+        }
+        found |= gfxPlatformFontList::FindAndAddFamiliesLocked(
+            aFontVisibilityProvider, aGeneric, target, aOutput, aFlags, aStyle,
+            aLanguage, aDevToCssSize);
+      }
+      return found;
+    }
+  }
+#endif
