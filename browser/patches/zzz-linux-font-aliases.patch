+#ifndef MOZ_WIDGET_GTK
+  // Camoufox (#325): a Linux claim asks for what fontconfig would give the
+  // name, never for the Apple or Microsoft face the flat package holds under
+  // it. Every target the gates admit is added, in fontconfig's order, as
+  // gfxFcPlatformFontList::FindAndAddFamiliesLocked does; none admitted is a
+  // miss, which is what the Linux host draws too (the list's default font).
+  // A target that is itself a key is skipped, so the recursion cannot re-enter
+  // this block.
+  if (SystemUISpoofedOS(aFontVisibilityProvider) == MaskConfig::SpoofedOS::Linux) {
