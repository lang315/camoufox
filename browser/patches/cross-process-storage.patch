diff --git a/dom/base/RoverfoxStorageManager.cpp b/dom/base/RoverfoxStorageManager.cpp
new file mode 100644
index 0000000000..b83a4b463b
--- /dev/null
+++ b/dom/base/RoverfoxStorageManager.cpp
@@ -0,0 +1,365 @@
+#include "RoverfoxStorageManager.h"
+#include "FontListManager.h"
+#include "mozilla/Preferences.h"
+#include "nsIPrefBranch.h"
+#include "nsXULAppAPI.h"
+#include "mozilla/dom/ContentChild.h"
+#include "nsThreadUtils.h"
+#include "jsapi.h"
+#include "js/PropertyAndElement.h"
+#include "mozilla/dom/Document.h"
+#include "nsIPrincipal.h"
+#include "nsContentUtils.h"
+#include "nsGlobalWindowInner.h"
+#include "xpcpublic.h"
+
+#include <algorithm>
+
+namespace mozilla {
+namespace dom {
+
+// Values live on the DEFAULT pref branch. They are session state (per-context
+// values a launch sets up), and default prefs are never written to prefs.js:
+// as user prefs a persistent profile kept them, so a relaunch with a different
+// config still reported the previous session's timezone and navigator values.
+// Reading the default branch alone also ignores user values an older build
+// left in a profile's prefs.js.
+static constexpr auto kKind = PrefValueKind::Default;
+
+// Firefox sends no string pref longer than 4 KiB to another process
+// (MAX_ADVISABLE_PREF_LENGTH in Preferences.cpp), so a longer value -- a font
+// list of a few hundred names -- is written as chunk prefs the roverfox.s.
+// callback does not match, then roverfox.s.<key> as a header naming them. Pref
+// updates reach a process in the order the parent made them, so the header's
+// callback runs once every chunk has arrived (#231).
+static constexpr uint32_t kChunkBytes = 3072;
+// Leads every header. No value a setter stores starts with it (numbers,
+// "0"/"1", the launcher's strings), and StorePref chunks any value that does,
+// so a header is never mistaken for a value.
+static constexpr char kChunkMark = '\x01';
+
+static nsCString ChunkPrefName(const nsACString& aPrefName, uint32_t aIndex) {
+  nsCString name("roverfox.c."_ns);
+  name.Append(Substring(aPrefName, "roverfox.s."_ns.Length()));
+  name.AppendPrintf(".%u", aIndex);
+  return name;
+}
+
+/* static */ void RoverfoxStorageManager::StorePref(const nsACString& aPrefName,
+                                                    const nsACString& aValue) {
+  MOZ_ASSERT(XRE_IsParentProcess());
+  const nsPromiseFlatCString& name = PromiseFlatCString(aPrefName);
+  if (aValue.Length() <= kChunkBytes &&
+      (aValue.IsEmpty() || aValue.First() != kChunkMark)) {
+    Preferences::SetCString(name.get(), aValue, kKind);
+    return;
+  }
+  uint32_t count = 0;
+  for (uint32_t start = 0; start < aValue.Length(); ++count) {
+    uint32_t end = std::min<uint32_t>(start + kChunkBytes, aValue.Length());
+    // End on a code point: UTF-8 has at most three continuation bytes.
+    for (int i = 0; i < 3 && end < aValue.Length() &&
+                    (static_cast<uint8_t>(aValue[end]) & 0xC0) == 0x80;
+         ++i) {
+      --end;
+    }
+    Preferences::SetCString(ChunkPrefName(aPrefName, count).get(),
+                            Substring(aValue, start, end - start), kKind);
+    start = end;
+  }
+  // libpref notifies only a changed value, so the generation keeps a later
+  // value with the same chunk count from going unseen.
+  static uint32_t sGeneration = 0;
+  nsAutoCString header;
+  header.AppendPrintf("%c%u:%u", kChunkMark, count, ++sGeneration);
+  Preferences::SetCString(name.get(), header, kKind);
+}
+
+/* static */ void RoverfoxStorageManager::LoadPref(const nsACString& aPrefName,
+                                                   nsACString& aOutValue) {
+  MOZ_ASSERT(NS_IsMainThread());
+  Preferences::GetCString(PromiseFlatCString(aPrefName).get(), aOutValue,
+                          kKind);
+  if (aOutValue.IsEmpty() || aOutValue.First() != kChunkMark) {
+    return;
+  }
+  nsresult rv;
+  const uint32_t count = Substring(aOutValue, 1, aOutValue.FindChar(':') - 1)
+                             .ToUnsignedInteger(&rv);
+  aOutValue.Truncate();
+  for (uint32_t i = 0; NS_SUCCEEDED(rv) && i < count; ++i) {
+    nsAutoCString chunk;
+    rv = Preferences::GetCString(ChunkPrefName(aPrefName, i).get(), chunk,
+                                 kKind);
+    aOutValue.Append(chunk);
+  }
+  // Part of a font list is a wrong answer; no value is a known one.
+  if (NS_FAILED(rv)) {
+    aOutValue.Truncate();
+  }
+}
+
+/* static */ nsTHashMap<nsCStringHashKey, nsCString>&
+RoverfoxStorageManager::GetLocalCache() {
+  static nsTHashMap<nsCStringHashKey, nsCString> sCache;
+  return sCache;
+}
+
+/* static */ nsTHashSet<nsCString>& RoverfoxStorageManager::GetMissCache() {
+  static nsTHashSet<nsCString> sMisses;
+  return sMisses;
+}
+
+/* static */ mozilla::Mutex&
+RoverfoxStorageManager::GetLocalCacheMutex() {
+  static mozilla::Mutex sMutex("RoverfoxStorageCache");
+  return sMutex;
+}
+
+/* static */ nsCString
+RoverfoxStorageManager::MakePrefName(const nsAString& key) {
+  nsAutoCString prefName("roverfox.s.");
+  AppendUTF16toUTF8(key, prefName);
+  return nsCString(prefName);
+}
+
+static void OnStoragePrefChanged(const char* aPrefName, void*) {
+  nsDependentCString name(aPrefName);
+  RoverfoxStorageManager::MirrorPref(name);
+  // Camoufox: a context's font list reached this process. A lookup that ran
+  // before it arrived answered without it and memoized that answer, so the
+  // font caches are flushed here -- after MirrorPref has released the cache
+  // mutex, which the font list's lookups take under their own locks.
+  constexpr auto kFontListPrefix = "roverfox.s.fontlist_"_ns;
+  if (StringBeginsWith(name, kFontListPrefix)) {
+    nsresult rv;
+    uint32_t id =
+        Substring(name, kFontListPrefix.Length()).ToUnsignedInteger(&rv);
+    if (NS_SUCCEEDED(rv)) {
+      FontListManager::OnFontListStored(id);
+    }
+  }
+}
+
+/* static */ void RoverfoxStorageManager::MirrorPref(const nsACString& aPrefName) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsAutoCString value;
+  LoadPref(aPrefName, value);
+  MutexAutoLock lock(GetLocalCacheMutex());
+  GetMissCache().Remove(aPrefName);
+  if (value.IsEmpty()) {
+    GetLocalCache().Remove(aPrefName);
+  } else {
+    GetLocalCache().InsertOrUpdate(aPrefName, value);
+  }
+}
+
+// libpref's table is main-thread only: a release build looks it up without a
+// lock, so a worker reading it while the main thread inserted a pref (another
+// context putting its values) crashed the content process -- measured within
+// seconds with workers reading navigator while contexts were created. Workers
+// read the local cache alone, and the main thread keeps that cache a mirror of
+// every roverfox.s.* pref: a snapshot the first time this process uses the
+// storage on the main thread, then the prefix callback. A value already cached
+// locally wins over the snapshot, as it does in ReadValue.
+/* static */ void RoverfoxStorageManager::EnsureMirror() {
+  static bool sMirrored = false;
+  if (sMirrored || !NS_IsMainThread()) {
+    return;
+  }
+  sMirrored = true;
+  Preferences::RegisterPrefixCallback(OnStoragePrefChanged, "roverfox.s."_ns);
+
+  nsTArray<nsCString> names;
+  nsIPrefBranch* root = Preferences::GetRootBranch(kKind);
+  if (!root || NS_FAILED(root->GetChildList("roverfox.s.", names))) {
+    return;
+  }
+  for (const nsCString& name : names) {
+    nsAutoCString value;
+    LoadPref(name, value);
+    if (value.IsEmpty()) {
+      continue;
+    }
+    MutexAutoLock lock(GetLocalCacheMutex());
+    if (!GetLocalCache().Contains(name)) {
+      GetLocalCache().InsertOrUpdate(name, nsCString(value));
+    }
+  }
+}
+
+/* static */ void
+RoverfoxStorageManager::SetPrefValue(const nsCString& prefName,
+                                      const nsCString& value) {
+  EnsureMirror();
+  // Always store locally for immediate reads in this process
+  {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    GetLocalCache().InsertOrUpdate(prefName, nsCString(value));
+    GetMissCache().Remove(prefName);
+  }
+  // Sync to parent for cross-process availability
+  if (XRE_IsParentProcess()) {
+    StorePref(prefName, value);
+  } else {
+    ContentChild* cc = ContentChild::GetSingleton();
+    if (cc) {
+      cc->SendRoverfoxStoragePut(prefName, value);
+    }
+  }
+}
+
+/* static */ void RoverfoxStorageManager::ReadValue(const nsCString& prefName,
+                                                    nsACString& outValue) {
+  EnsureMirror();
+  // Local cache first (values set in this process, and the pref mirror)
+  {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    if (auto entry = GetLocalCache().Lookup(prefName)) {
+      outValue = entry.Data();
+    }
+  }
+  // Off the main thread the mirror is the whole answer (see EnsureMirror).
+  if (!outValue.IsEmpty() || !NS_IsMainThread()) {
+    return;
+  }
+  // Then Preferences (values synced from other processes)
+  LoadPref(prefName, outValue);
+  if (!outValue.IsEmpty() || XRE_IsParentProcess()) {
+    return;
+  }
+  // Sync IPC read from the parent covers a value another process put that has
+  // not reached this process's prefs yet. Once per key: a sync IPC on every
+  // read of an unset key (every read in a launch without per-context values)
+  // made navigator.hardwareConcurrency, screen.* and (color) queries ~20x
+  // slower than stock, a timing a page can measure. A later put anywhere
+  // clears the miss (pref callback / SetPrefValue).
+  {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    if (GetMissCache().Contains(prefName)) {
+      return;
+    }
+  }
+  ContentChild* cc = ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  nsCString fromParent;
+  cc->SendRoverfoxStorageGet(prefName, &fromParent);
+  outValue = fromParent;
+  MutexAutoLock lock(GetLocalCacheMutex());
+  if (fromParent.IsEmpty()) {
+    GetMissCache().Insert(prefName);
+  } else {
+    GetLocalCache().InsertOrUpdate(prefName, fromParent);
+  }
+}
+
+/* static */ void
+RoverfoxStorageManager::PutUint(const nsAString& key, uint32_t value) {
+  nsCString prefName = MakePrefName(key);
+  nsAutoCString strValue;
+  strValue.AppendInt(static_cast<int64_t>(value));
+  SetPrefValue(prefName, strValue);
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetUint(const nsAString& key, uint32_t& outValue) {
+  nsAutoCString strValue;
+  ReadValue(MakePrefName(key), strValue);
+  if (!strValue.IsEmpty()) {
+    nsresult parseRv;
+    int64_t parsed = strValue.ToInteger64(&parseRv);
+    if (NS_SUCCEEDED(parseRv) && parsed >= 0) {
+      outValue = static_cast<uint32_t>(parsed);
+      return true;
+    }
+  }
+  return false;
+}
+
+/* static */ void
+RoverfoxStorageManager::PutBool(const nsAString& key, bool value) {
+  nsCString prefName = MakePrefName(key);
+  nsAutoCString strValue(value ? "1" : "0");
+  SetPrefValue(prefName, strValue);
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetBool(const nsAString& key, bool& outValue) {
+  nsAutoCString strValue;
+  ReadValue(MakePrefName(key), strValue);
+  if (!strValue.IsEmpty()) {
+    outValue = strValue.EqualsLiteral("1");
+    return true;
+  }
+  return false;
+}
+
+/* static */ void
+RoverfoxStorageManager::PutString(const nsAString& key,
+                                   const nsAString& value) {
+  nsCString prefName = MakePrefName(key);
+  nsAutoCString utf8Value;
+  CopyUTF16toUTF8(value, utf8Value);
+  SetPrefValue(prefName, utf8Value);
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetString(const nsAString& key, nsAString& outValue) {
+  nsAutoCString utf8Value;
+  ReadValue(MakePrefName(key), utf8Value);
+  if (!utf8Value.IsEmpty()) {
+    CopyUTF8toUTF16(utf8Value, outValue);
+    return true;
+  }
+  return false;
+}
+
+/* static */ uint32_t RoverfoxStorageManager::UserContextId(
+    nsIPrincipal* aPrincipal) {
+  return aPrincipal ? aPrincipal->OriginAttributesRef().mUserContextId : 0;
+}
+
+/* static */ uint32_t RoverfoxStorageManager::UserContextId(
+    const nsINode* aNode) {
+  return aNode ? UserContextId(aNode->NodePrincipal()) : 0;
+}
+
+/* static */ uint32_t RoverfoxStorageManager::UserContextId(
+    nsPIDOMWindowInner* aWindow) {
+  return aWindow ? UserContextId(aWindow->GetExtantDoc()) : 0;
+}
+
+static nsString SetterUsedKey(const char* aName, uint32_t aUserContextId) {
+  nsString key;
+  key.AppendPrintf("%s_d_%u", aName, aUserContextId);
+  return key;
+}
+
+/* static */ void RoverfoxStorageManager::MarkSetterUsed(
+    const char* aName, uint32_t aUserContextId) {
+  PutBool(SetterUsedKey(aName, aUserContextId), true);
+}
+
+/* static */ bool RoverfoxStorageManager::IsSetterOffered(JSObject* aObj,
+                                                          const char* aName) {
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aObj);
+  if (!win) return false;
+  bool used = false;
+  GetBool(SetterUsedKey(aName, UserContextId(win)), used);
+  return !used;
+}
+
+/* static */ void RoverfoxStorageManager::RemoveSetter(const char* aName) {
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  if (!cx) return;
+  JS::Rooted<JSObject*> global(cx, JS::CurrentGlobalOrNull(cx));
+  if (!global) return;
+  JS::Rooted<JS::Value> undef(cx, JS::UndefinedValue());
+  JS_SetProperty(cx, global, aName, undef);
+  JS_DeleteProperty(cx, global, aName);
+}
+
+}  // namespace dom
+}  // namespace mozilla
diff --git a/dom/base/RoverfoxStorageManager.h b/dom/base/RoverfoxStorageManager.h
new file mode 100644
index 0000000000..761e54c394
--- /dev/null
+++ b/dom/base/RoverfoxStorageManager.h
@@ -0,0 +1,72 @@
+#ifndef mozilla_dom_RoverfoxStorageManager_h
+#define mozilla_dom_RoverfoxStorageManager_h
+
+#include "nsString.h"
+#include "nsTHashMap.h"
+#include "nsTHashSet.h"
+#include "nsHashKeys.h"
+#include "mozilla/Mutex.h"
+
+class JSObject;
+class nsINode;
+class nsIPrincipal;
+class nsPIDOMWindowInner;
+
+namespace mozilla {
+namespace dom {
+
+// Cross-process key-value storage using Firefox Preferences + local cache.
+// Write-through: values stored locally (immediate reads) and sent to parent
+// process via IPDL (cross-process sync via Preferences API).
+// Keys prefixed with "roverfox.s." to avoid conflicts.
+class RoverfoxStorageManager {
+ public:
+  static void PutUint(const nsAString& key, uint32_t value);
+  static bool GetUint(const nsAString& key, uint32_t& outValue);
+  static void PutBool(const nsAString& key, bool value);
+  static bool GetBool(const nsAString& key, bool& outValue);
+  static void PutString(const nsAString& key, const nsAString& value);
+  static bool GetString(const nsAString& key, nsAString& outValue);
+  // A put reached this process's prefs: copy it into the local cache (main
+  // thread only), which is all a worker thread reads.
+  static void MirrorPref(const nsACString& aPrefName);
+  // Main thread only, idempotent. Called from ContentChild::InitXPCOM so the
+  // mirror is live before any worker can read; the main-thread paths also
+  // call it lazily.
+  static void EnsureMirror();
+  // Main thread. StorePref (parent only) writes a pref the way every process
+  // can receive it, chunking a value over the size Firefox syncs; LoadPref
+  // reads one back whole.
+  static void StorePref(const nsACString& aPrefName, const nsACString& aValue);
+  static void LoadPref(const nsACString& aPrefName, nsACString& aOutValue);
+
+  // The userContextId per-context values are stored under: the principal's.
+  // A document without a browsing context of its own (createHTMLDocument,
+  // DOMParser) shares its creator's principal, so it finds its context's
+  // values where a browsing-context lookup found none.
+  static uint32_t UserContextId(nsIPrincipal* aPrincipal);
+  static uint32_t UserContextId(const nsINode* aNode);
+  static uint32_t UserContextId(nsPIDOMWindowInner* aWindow);
+
+  // Per-context window.setX() setters. A setter is offered to a window until
+  // its context has used it; aName names the setter's "used" flag.
+  static void MarkSetterUsed(const char* aName, uint32_t aUserContextId);
+  static bool IsSetterOffered(JSObject* aObj, const char* aName);
+  // Removes a setter the running script has just called from its global.
+  // Assigning undefined first busts the IC/shape caches that otherwise keep a
+  // deleted name reachable on ARM64.
+  static void RemoveSetter(const char* aName);
+
+ private:
+  static nsCString MakePrefName(const nsAString& key);
+  static void SetPrefValue(const nsCString& prefName, const nsCString& value);
+  static void ReadValue(const nsCString& prefName, nsACString& outValue);
+  static nsTHashSet<nsCString>& GetMissCache();
+  static nsTHashMap<nsCStringHashKey, nsCString>& GetLocalCache();
+  static mozilla::Mutex& GetLocalCacheMutex();
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_RoverfoxStorageManager_h
