diff --git a/dom/ipc/ContentParent.cpp b/dom/ipc/ContentParent.cpp
index a3b9fd9ead..0aac7734a2 100644
--- a/dom/ipc/ContentParent.cpp
+++ b/dom/ipc/ContentParent.cpp
@@ -122,6 +122,7 @@
 #include "mozilla/dom/PushNotifier.h"
 #include "mozilla/dom/RemoteWorkerDebuggerManagerParent.h"
 #include "mozilla/dom/RemoteWorkerServiceParent.h"
+#include "mozilla/dom/RoverfoxStorageManager.h"
 #include "mozilla/dom/ServiceWorkerManager.h"
 #include "mozilla/dom/ServiceWorkerRegistrar.h"
 #include "mozilla/dom/ServiceWorkerUtils.h"
@@ -1276,6 +1277,26 @@ mozilla::ipc::IPCResult ContentParent::RecvCreateGMPService() {
   return IPC_OK();
 }
 
+mozilla::ipc::IPCResult ContentParent::RecvRoverfoxStoragePut(
+    const nsCString& aPrefName, const nsCString& aValue) {
+  // Only allow roverfox-namespaced prefs for security
+  if (!StringBeginsWith(aPrefName, "roverfox.s."_ns)) {
+    return IPC_OK();
+  }
+  RoverfoxStorageManager::StorePref(aPrefName, aValue);
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentParent::RecvRoverfoxStorageGet(
+    const nsCString& aPrefName, nsCString* aOutValue) {
+  if (!StringBeginsWith(aPrefName, "roverfox.s."_ns)) {
+    *aOutValue = ""_ns;
+    return IPC_OK();
+  }
+  RoverfoxStorageManager::LoadPref(aPrefName, *aOutValue);
+  return IPC_OK();
+}
