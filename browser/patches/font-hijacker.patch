+already_AddRefed<gfxFontEntry> gfxDWriteFontList::CreateBundledFontEntry(
+    fontlist::Face* aFace, const fontlist::Family* aFamily) {
+  MOZ_SEH_TRY {
+    RefPtr<IDWriteFont> font = FindBundledFont(aFamily, aFace);
+    if (!font) {
+      return nullptr;
+    }
+    RefPtr fe = MakeRefPtr<gfxDWriteFontEntry>(
+        aFace->mDescriptor.AsString(SharedFontList()), font, false);
+    fe->InitializeFrom(aFace, aFamily);
+    fe->mForceGDIClassic = aFamily->IsForceClassic();
+    fe->mMayUseGDIAccess = aFamily->IsSimple();
+    return fe.forget();
+  }
+  MOZ_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {
+    gfxCriticalNote << "Exception occurred while creating font entry for "
+                    << aFamily->DisplayName().AsString(SharedFontList()).get();
+  }
+  return nullptr;
+}
