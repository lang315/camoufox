+already_AddRefed<IDWriteFontCollection> gfxDWriteFontList::BundledFamilyCollection(
+    const fontlist::Family* aFamily) {
+  MutexAutoLock lock(mBundledFamiliesLock);
+  RefPtr<IDWriteFontCollection> collection;
+  if (mBundledFamilyCollections.Get(aFamily->Index(), &collection)) {
+    return collection.forget();
+  }
+  fontlist::FontList* list = SharedFontList();
+  const fontlist::Pointer* facePtrs = aFamily->Faces(list);
+  nsTArray<nsString> paths;
+  for (uint32_t i = 0; facePtrs && i < aFamily->NumFaces(); ++i) {
+    auto* face = facePtrs[i].ToPtr<fontlist::Face>(list);
+    if (!face || face->mFilePath.IsNull()) {
+      continue;
+    }
+    NS_ConvertUTF8toUTF16 path(face->mFilePath.AsString(list));
+    if (!path.IsEmpty() && !paths.Contains(path)) {
+      paths.AppendElement(path);
+    }
+  }
+  if (paths.IsEmpty()) {
+    return nullptr;
+  }
+  RefPtr<IDWriteFactory> factory = Factory::EnsureDWriteFactory();
+  RefPtr<FamilyFilesLoader> loader = new FamilyFilesLoader();
+  if (!factory || FAILED(factory->RegisterFontCollectionLoader(loader))) {
+    return nullptr;
+  }
+  const void* key = &paths;
+  HRESULT hr = factory->CreateCustomFontCollection(loader, &key, sizeof(key),
+                                                   getter_AddRefs(collection));
+  factory->UnregisterFontCollectionLoader(loader);
+  if (FAILED(hr) || !collection) {
+    return nullptr;
+  }
+  mBundledFamilyCollections.InsertOrUpdate(aFamily->Index(), collection);
+  return collection.forget();
+}
