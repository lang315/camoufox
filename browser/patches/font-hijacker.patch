+// Camoufox: the font file and the face index within it, as the bundled-face
+// lookup of a content process keys them (see FindBundledFont).
+static bool GetFontFileInfo(IDWriteFontFace* aFace, nsCString& aPath,
+                            uint16_t& aIndex) {
+  UINT32 count = 0;
+  if (FAILED(aFace->GetFiles(&count, nullptr)) || !count) {
+    return false;
+  }
+  AutoTArray<IDWriteFontFile*, 1> files;
+  files.SetLength(count);
+  if (FAILED(aFace->GetFiles(&count, files.Elements()))) {
+    return false;
+  }
+  bool ok = false;
+  for (UINT32 i = 0; i < count; ++i) {
+    RefPtr<IDWriteFontFile> file = dont_AddRef(files[i]);
+    RefPtr<IDWriteFontFileLoader> loader;
+    RefPtr<IDWriteLocalFontFileLoader> local;
+    const void* key;
+    UINT32 keySize;
+    UINT32 length;
+    if (i == 0 && SUCCEEDED(file->GetLoader(getter_AddRefs(loader))) &&
+        SUCCEEDED(loader->QueryInterface(__uuidof(IDWriteLocalFontFileLoader),
+                                         (void**)getter_AddRefs(local))) &&
+        SUCCEEDED(file->GetReferenceKey(&key, &keySize)) &&
+        SUCCEEDED(local->GetFilePathLengthFromKey(key, keySize, &length))) {
+      nsAutoString path;
+      path.SetLength(length);
+      if (SUCCEEDED(local->GetFilePathFromKey(
+              key, keySize, (WCHAR*)path.BeginWriting(), length + 1))) {
+        CopyUTF16toUTF8(path, aPath);
+        aIndex = uint16_t(aFace->GetIndex());
+        ok = true;
+      }
+    }
+  }
+  return ok;
+}
