+// A font is the shared-list face when it agrees with everything the parent
+// recorded for that face: PostScript name, file, index in the file, and
+// weight, width and style.
+static bool FontIsSharedFace(IDWriteFont* aFont, const fontlist::Face* aFace,
+                             const nsCString& aPSName,
+                             const nsCString& aFilePath) {
+  RefPtr<IDWriteFontFace> dwFace;
+  if (aFont->GetSimulations() != DWRITE_FONT_SIMULATIONS_NONE ||
+      FAILED(aFont->CreateFontFace(getter_AddRefs(dwFace)))) {
+    return false;
+  }
+  nsCString path;
+  uint16_t fileIndex;
+  if (!GetFontFileInfo(dwFace, path, fileIndex) || fileIndex != aFace->mFileIndex ||
+      path != aFilePath) {
+    return false;
+  }
+  DWRITE_FONT_STYLE style = aFont->GetStyle();
+  if (aFace->mWeight != WeightRange(FontWeight::FromInt(aFont->GetWeight())) ||
+      aFace->mWidth != WidthRange(FontWidthFromDWriteStretch(aFont->GetStretch())) ||
+      aFace->mStyle != SlantStyleRange(style == DWRITE_FONT_STYLE_NORMAL
+                                           ? FontSlantStyle::NORMAL
+                                       : style == DWRITE_FONT_STYLE_ITALIC
+                                           ? FontSlantStyle::ITALIC
+                                           : FontSlantStyle::OBLIQUE)) {
+    return false;
+  }
+  nsAutoCString psName;
+  if (FAILED(GetDirectWriteFaceName(aFont, PSNAME_ID, psName))) {
+    GetPostScriptNameFromNameTable(dwFace, psName);
+  }
+  return psName == aPSName;
+}
+
+// The family of the one-family collection is the one holding a face of the
+// shared face's key; the face is the one at the shared face's index in it,
+// accepted only if it has that key. Anything else is a miss, never a guess.
+already_AddRefed<IDWriteFont> gfxDWriteFontList::FindBundledFont(
+    const fontlist::Family* aFamily, const fontlist::Face* aFace) {
+  fontlist::FontList* list = SharedFontList();
+  nsCString filePath;
+  if (!aFace->mFilePath.IsNull()) {
+    filePath = aFace->mFilePath.AsString(list);
+  }
+  nsCString psName(aFace->mDescriptor.AsString(list));
+  RefPtr<IDWriteFontCollection> collection =
+      filePath.IsEmpty() ? nullptr : BundledFamilyCollection(aFamily);
+  RefPtr<IDWriteFontFamily> holder;
+  UINT32 count = collection ? collection->GetFontFamilyCount() : 0;
+  for (UINT32 f = 0; f < count && !holder; ++f) {
+    RefPtr<IDWriteFontFamily> family;
+    if (FAILED(collection->GetFontFamily(f, getter_AddRefs(family)))) {
+      continue;
+    }
+    if (count == 1) {
+      holder = family;
+      break;
+    }
+    for (UINT32 j = 0; j < family->GetFontCount(); ++j) {
+      RefPtr<IDWriteFont> font;
+      if (SUCCEEDED(family->GetFont(j, getter_AddRefs(font))) && font &&
+          FontIsSharedFace(font, aFace, psName, filePath)) {
+        holder = family;
+        break;
+      }
+    }
+  }
+  RefPtr<IDWriteFont> font;
+  if (holder && SUCCEEDED(holder->GetFont(aFace->mIndex, getter_AddRefs(font))) &&
+      font && FontIsSharedFace(font, aFace, psName, filePath)) {
+    return font.forget();
+  }
+  LOG_FONTLIST(("CAMOU-FL bundled-face-miss family=%s face=%s index=%u",
+                aFamily->Key().AsString(list).get(), psName.get(),
+                unsigned(aFace->mIndex)));
+  return nullptr;
+}
