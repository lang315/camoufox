diff --git a/gfx/thebes/gfxDWriteFontList.cpp b/gfx/thebes/gfxDWriteFontList.cpp
index 5b659113f3..82932d796e 100644
--- a/gfx/thebes/gfxDWriteFontList.cpp
+++ b/gfx/thebes/gfxDWriteFontList.cpp
@@ -22,6 +22,8 @@
 #include "mozilla/Utf16.h"
 #include "mozilla/WindowsProcessMitigations.h"
 #include "mozilla/dom/Document.h"
+#include "mozilla/dom/FontListManager.h"
+#include "mozilla/dom/NavigatorManager.h"
 #include "mozilla/gfx/Logging.h"
 #include "mozilla/glean/GfxMetrics.h"
 #include "mozilla/intl/OSPreferences.h"
@@ -2155,10 +2157,32 @@ bool gfxDWriteFontList::FindAndAddFamiliesLocked(
           : nsContentUtils::ShouldResistFingerprinting(
                 "aFontVisibilityProvider is not available",
                 RFPTarget::UseHardcodedFontSubstitutes);
+  // Camoufox (#193): substitution is Windows behaviour, and the base-class gate
+  // only ever sees the substitute. So an identity of another OS refuses an
+  // alias its list does not allow; chrome and a Windows or native identity
+  // keep stock substitution.
+  auto camouRefusesAlias = [&]() {
+    if (aFontVisibilityProvider && aFontVisibilityProvider->IsChrome()) {
+      return false;
+    }
+    const auto os = mozilla::dom::NavigatorManager::GetSpoofedOS(
+        mozilla::dom::FontListManager::ContextIdFor(aFontVisibilityProvider));
+    if (os == MaskConfig::SpoofedOS::None ||
+        os == MaskConfig::SpoofedOS::Windows ||
+        CamouIsFamilyAllowed(aFontVisibilityProvider, keyName)) {
+      return false;
+    }
+    LOG_FONTLIST(("CAMOU-FL dwrite-subst os=%d key=%s allowed=0",
+                  static_cast<int>(os), keyName.get()));
+    return true;
+  };
   if (SharedFontList()) {
     nsACString* subst = useHardcodedList ? mHardcodedSubstitutions.Get(keyName)
                                          : mSubstitutions.Get(keyName);
     if (subst) {
+      if (camouRefusesAlias()) {
+        return false;
+      }
       keyName = *subst;
     }
   } else {
@@ -2169,6 +2193,9 @@ bool gfxDWriteFontList::FindAndAddFamiliesLocked(
                                ? aFontVisibilityProvider->GetFontVisibility()
                                : FontVisibility::User;
     if (ff && IsVisibleToCSS(*ff, level)) {
+      if (camouRefusesAlias()) {
+        return false;
+      }
       aOutput->AppendElement(FamilyAndGeneric(ff, aGeneric));
       return true;
     }
