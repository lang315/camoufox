+// Camoufox (#131): whether system-ui, for a context with its own font list,
+// is the family GetSystemUIFontFamilies names for the OS the context presents.
+// AddGenericFonts' per-context table step would otherwise answer it with the
+// sans-serif row and return before GetPrefFontsLangGroupLocked reaches the
+// hook. A family the context's list refuses leaves the answer to the table.
+// aKey receives the family's lowercased key for the log line.
+static bool CamouSystemUIFromHook(
+    FontVisibilityProvider* aFontVisibilityProvider,
+    StyleGenericFontFamily aGenericType, nsAtom* aLangGroup, nsACString& aKey) {
+  if (aGenericType != StyleGenericFontFamily::SystemUi ||
+      SystemUISpoofedOS(aFontVisibilityProvider) ==
+          MaskConfig::SpoofedOS::None) {
+    return false;
+  }
+  AutoTArray<nsCString, 1> families;
+  GetSystemUIFontFamilies(aFontVisibilityProvider, aLangGroup, families);
+  return !families.IsEmpty() &&
+         gfxPlatformFontList::CamouIsFamilyAllowed(aFontVisibilityProvider,
+                                                   families[0], &aKey);
+}
