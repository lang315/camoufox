+// Camoufox (#131): whether system-ui, for a context with its own font list,
+// skips AddGenericFonts' per-context table step and is answered by the pref
+// path as in stock. The table would otherwise answer it with the sans-serif
+// row and return before GetPrefFontsLangGroupLocked reaches the system-ui
+// hook. A native identity always takes the pref path: stock's own family,
+// gated by the read filter like every pref font. A spoofed OS takes it when
+// the context's list allows the family GetSystemUIFontFamilies names, whose
+// lowercased key aKey then receives; a refused family leaves it to the table.
+static bool CamouSystemUIFromPrefs(
+    FontVisibilityProvider* aFontVisibilityProvider,
+    StyleGenericFontFamily aGenericType, nsAtom* aLangGroup, nsACString& aKey) {
+  if (aGenericType != StyleGenericFontFamily::SystemUi) {
+    return false;
+  }
+  if (SystemUISpoofedOS(aFontVisibilityProvider) ==
+      MaskConfig::SpoofedOS::None) {
+    return true;
+  }
+  AutoTArray<nsCString, 1> families;
+  GetSystemUIFontFamilies(aFontVisibilityProvider, aLangGroup, families);
+  return !families.IsEmpty() &&
+         gfxPlatformFontList::CamouIsFamilyAllowed(aFontVisibilityProvider,
+                                                   families[0], &aKey);
+}
+
+// Camoufox (#263): under a native identity system-ui resolves as the host does,
+// so the family GetSystemUIFontFamilies names is the OS's own. No font list
+// names it (on macOS it is the hidden .SF NS), so the launch mask would refuse
+// the one family stock draws system-ui with. Only that family is exempt.
+static bool CamouNativeSystemUINames(
+    FontVisibilityProvider* aFontVisibilityProvider,
+    StyleGenericFontFamily aGenericType, nsAtom* aLangGroup,
+    nsTArray<nsCString>& aNames) {
+  if (aGenericType != StyleGenericFontFamily::SystemUi ||
+      SystemUISpoofedOS(aFontVisibilityProvider) !=
+          MaskConfig::SpoofedOS::None) {
+    return false;
+  }
+  GetSystemUIFontFamilies(aFontVisibilityProvider, aLangGroup, aNames);
+  return true;
+}
+
+bool gfxPlatformFontList::CamouIsNativeSystemUIName(
+    FontVisibilityProvider* aFontVisibilityProvider,
+    StyleGenericFontFamily aGenericType, nsAtom* aLangGroup,
+    const nsACString& aKey) {
+  AutoTArray<nsCString, 1> names;
+  if (!CamouNativeSystemUINames(aFontVisibilityProvider, aGenericType,
+                                aLangGroup, names)) {
+    return false;
+  }
+  for (const nsCString& name : names) {
+    nsAutoCString nameKey;
+    GenerateFontListKey(name, nameKey);
+    if (nameKey == aKey) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool gfxPlatformFontList::CamouIsNativeSystemUIFamily(
+    FontVisibilityProvider* aFontVisibilityProvider,
+    StyleGenericFontFamily aGenericType, nsAtom* aLangGroup,
+    const FontFamily& aFamily) {
+  AutoTArray<nsCString, 1> names;
+  if (!CamouNativeSystemUINames(aFontVisibilityProvider, aGenericType,
+                                aLangGroup, names)) {
+    return false;
+  }
+  for (const nsCString& name : names) {
+    AutoTArray<FamilyAndGeneric, 10> families;
+    FindAndAddFamiliesLocked(aFontVisibilityProvider, aGenericType, name,
+                             &families, FindFamiliesFlags(0), nullptr,
+                             aLangGroup);
+    for (const FamilyAndGeneric& f : families) {
+      if (f.mFamily == aFamily) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
