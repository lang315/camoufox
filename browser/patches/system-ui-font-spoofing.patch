+// Camoufox (#131): whether system-ui, for a context with its own font list,
+// skips AddGenericFonts' per-context table step and is answered by the pref
+// path as in stock. The table would otherwise answer it with the sans-serif
+// row and return before GetPrefFontsLangGroupLocked reaches the system-ui
+// hook. A native identity always takes the pref path: stock's own family,
+// gated by the read filter like every pref font. A spoofed OS takes it when
+// the context's list allows the family GetSystemUIFontFamilies names, whose
+// lowercased key aKey then receives; a refused family leaves it to the table.
+static bool CamouSystemUIFromPrefs(
+    FontVisibilityProvider* aFontVisibilityProvider,
+    StyleGenericFontFamily aGenericType, nsAtom* aLangGroup, nsACString& aKey) {
+  if (aGenericType != StyleGenericFontFamily::SystemUi) {
+    return false;
+  }
+  if (SystemUISpoofedOS(aFontVisibilityProvider) ==
+      MaskConfig::SpoofedOS::None) {
+    return true;
+  }
+  AutoTArray<nsCString, 1> families;
+  GetSystemUIFontFamilies(aFontVisibilityProvider, aLangGroup, families);
+  return !families.IsEmpty() &&
+         gfxPlatformFontList::CamouIsFamilyAllowed(aFontVisibilityProvider,
+                                                   families[0], &aKey);
+}
