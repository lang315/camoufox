+      // Camoufox canvas perturbation. No-op when seed == 0 (spoofing off).
+      // Covers toDataURL / toBlob / OffscreenCanvas.convertToBlob (BGRA packed).
+      // toBlob still asks for the buffer under the placeholder and then
+      // discards it, so that read is neither noised nor recorded.
+      if (aExtractionBehavior != CanvasUtils::ImageExtraction::Placeholder) {
+        Document* seedDoc =
+            CanvasSeedDocumentFor(mCanvasElement, mOffscreenCanvas);
+        if (camoufox::AccessObserver::IsArmed()) {
+          camoufox::RecordSurfaceFromDocument(seedDoc,
+                                              camoufox::SurfaceId::Canvas);
+        }
+        uint32_t seed = CanvasSeedManager::SeedFromDocument(seedDoc);
+        if (seed != 0 && ret) {
+          CanvasSeedManager::Perturb(
+              ret.get(),
