--- /dev/null
+++ b/dom/base/CanvasSeedManager.cpp
@@ -0,0 +1,127 @@
+#include "CanvasSeedManager.h"
+#include "MaskConfig.hpp"
+#include "mozilla/HashFunctions.h"
+#include "mozilla/Logging.h"
+#include "mozilla/dom/Document.h"
+#include "mozilla/dom/WorkerCommon.h"
+#include "mozilla/dom/WorkerPrivate.h"
+
+namespace mozilla {
+namespace dom {
+
+// Camoufox: guards read these lines to tell a perturbed read from one that
+// was not, which the pixels alone cannot show.
+static LazyLogModule sCamouCanvasLog("CamouCanvas");
+
+/* static */ nsString
+CanvasSeedManager::KeyForUserContext(uint32_t userContextId) {
+  nsString key;
+  key.AppendLiteral(u"canvas_seed_");
+  key.AppendInt(userContextId);
+  return key;
+}
+
+/* static */ void
+CanvasSeedManager::SetSeed(uint32_t userContextId, uint32_t seed) {
+  nsString key = KeyForUserContext(userContextId);
+  RoverfoxStorageManager::PutUint(key, seed);
+  DisableFunction(userContextId);
+  MOZ_LOG(sCamouCanvasLog, LogLevel::Debug,
+          ("CAMOU-CANVAS set ctx=%u seed=%u", userContextId, seed));
+}
+
+/* static */ uint32_t
+CanvasSeedManager::GetSeed(uint32_t userContextId) {
+  nsString key = KeyForUserContext(userContextId);
+  uint32_t seed = 0;
+  if (RoverfoxStorageManager::GetUint(key, seed) && seed != 0) {
+    return seed;
+  }
+  // Fallback to CAMOU_CONFIG so worker processes pick up the seed.
+  if (auto val = MaskConfig::GetUint32("canvas:seed")) {
+    return val.value();
+  }
+  return 0;
+}
+
+/* static */ void
+CanvasSeedManager::DisableFunction(uint32_t userContextId) {
+  RoverfoxStorageManager::MarkSetterUsed("canvas", userContextId);
+}
+
+/* static */ bool
+CanvasSeedManager::IsFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "canvas");
+}
+
+// Hash of the first kHashBytes of buf (or the whole buf if smaller).
+// Mixes content into the per-context seed so identical canvases on
+// different contexts diverge AND so resizing the same drawing keeps
+// the noise pattern coherent.
+static uint32_t HashContent(const uint8_t* buf, size_t len) {
+  constexpr size_t kHashBytes = 1024;
+  const size_t n = (len < kHashBytes) ? len : kHashBytes;
+  return mozilla::HashBytes(buf, n);
+}
+
+/* static */ void
+CanvasSeedManager::Perturb(uint8_t* data, size_t length,
+                           uint32_t seed, double density, uint32_t strength) {
+  if (seed == 0 || data == nullptr || length < 4 || density <= 0.0) {
+    return;
+  }
+  MOZ_LOG(sCamouCanvasLog, LogLevel::Debug,
+          ("CAMOU-CANVAS perturb seed=%u bytes=%zu", seed, length));
+  // Mix seed with content. Keeps noise deterministic per (seed, content).
+  uint32_t s = seed ^ HashContent(data, length);
+  if (s == 0) {
+    s = seed | 1u;
+  }
+  // LCG (the same LCG the audio/harfbuzz seed paths use).
+  const uint32_t kThreshold = static_cast<uint32_t>(density * 4294967296.0);
+  for (size_t i = 0; i < length; ++i) {
+    if ((i & 3u) == 3u) {
+      continue;  // skip alpha channel
+    }
+    s = s * 1103515245u + 12345u;
+    if (s < kThreshold) {
+      int32_t delta = ((s >> 16) & 1u) ? +static_cast<int32_t>(strength)
+                                       : -static_cast<int32_t>(strength);
+      int32_t v = static_cast<int32_t>(data[i]) + delta;
+      if (v < 0) v = 0;
+      else if (v > 255) v = 255;
+      data[i] = static_cast<uint8_t>(v);
+    }
+  }
+}
+
+/* static */ double
+CanvasSeedManager::GetNoiseDensity() {
+  if (auto v = MaskConfig::GetDouble("canvas:noiseDensity")) {
+    return v.value();
+  }
+  return 0.0005;  // 1 in 2000 channels
+}
+
+/* static */ uint32_t
+CanvasSeedManager::GetNoiseStrength() {
+  if (auto v = MaskConfig::GetUint32("canvas:noiseStrength")) {
+    return v.value();
+  }
+  return 1;  // ±1 LSB
+}
+
+/* static */ uint32_t
+CanvasSeedManager::SeedFromDocument(Document* aDoc) {
+  if (aDoc) {
+    return GetSeed(RoverfoxStorageManager::UserContextId(aDoc));
+  }
+  // A worker's canvas has no document; the worker carries its page's context.
+  if (WorkerPrivate* wp = GetCurrentThreadWorkerPrivate()) {
+    return GetSeed(wp->GetOriginAttributes().mUserContextId);
+  }
+  return 0;
+}
+
+} // namespace dom
+} // namespace mozilla
diff --git a/dom/base/CanvasSeedManager.h b/dom/base/CanvasSeedManager.h
new file mode 100644
index 0000000000..2990c22843
--- /dev/null
+++ b/dom/base/CanvasSeedManager.h
@@ -0,0 +1,64 @@
+#ifndef mozilla_dom_CanvasSeedManager_h
+#define mozilla_dom_CanvasSeedManager_h
+
+#include "nsString.h"
+#include "RoverfoxStorageManager.h"
+
+struct JSContext;
+
+namespace mozilla {
+namespace dom {
+
+class Document;
+
+/**
+ * CanvasSeedManager — per-userContextId canvas perturbation seed plus the
+ * Perturb() helper that applies deterministic ±1 LSB noise to RGBA buffers
+ * at the readback boundary. Used by:
+ *   - CanvasRenderingContext2D::GetImageData
+ *   - HTMLCanvasElement::ToDataURL / ToBlob
+ *   - OffscreenCanvas::ConvertToBlob / TransferToImageBitmap, in a worker too
+ *   - toDataURL / toBlob of a canvas whose control went to an OffscreenCanvas
+ *   - ClientWebGLContext::ReadPixels (default-FBO only), in a worker too
+ *
+ * Same seed + same source bytes → same output (deterministic), so a site
+ * reading the canvas twice cannot detect the noise by re-rendering. Two
+ * BrowsingContexts with different userContextId diverge.
+ */
+class CanvasSeedManager {
+ public:
+  static void SetSeed(uint32_t userContextId, uint32_t seed);
+  static uint32_t GetSeed(uint32_t userContextId);
+
+  static void DisableFunction(uint32_t userContextId);
+  static bool IsFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+
+  /**
+   * Deterministic LSB perturbation. Same (data, length, seed) → same output.
+   *   - Modifies RGB channels only; alpha untouched.
+   *   - density: 0..1 fraction of channels to perturb (Brave low-impact ≈ 0.0005).
+   *   - strength: signed delta in [1, 4]; values >1 produce visible banding.
+   *
+   * Caller is responsible for resolving `seed` from the right userContextId
+   * before invoking; passing seed == 0 makes this a no-op.
+   */
+  static void Perturb(uint8_t* data, size_t length,
+                      uint32_t seed, double density, uint32_t strength);
+
+  // Config-backed convenience accessors.
+  static double GetNoiseDensity();
+  static uint32_t GetNoiseStrength();
+
+  // The active seed for a document's context, read from its principal, so a
+  // document without a browsing context (DOMParser, createHTMLDocument) finds
+  // its creator's seed. With no document on a worker thread, the worker's.
+  static uint32_t SeedFromDocument(Document* aDoc);
+
+ private:
+  static nsString KeyForUserContext(uint32_t userContextId);
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_CanvasSeedManager_h
