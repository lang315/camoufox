+// Resolve the owning Document for canvas seed lookup: html canvas via its
+// element, offscreen (main-thread) via its owner window. Worker offscreen has
+// no Document, so this returns null and perturbation becomes a no-op.
+static Document* CanvasSeedDocumentFor(HTMLCanvasElement* aCanvasElement,
+                                       OffscreenCanvas* aOffscreenCanvas) {
+  if (aCanvasElement) {
+    return aCanvasElement->OwnerDoc();
+  }
+  if (aOffscreenCanvas) {
+    if (auto* win = aOffscreenCanvas->GetOwnerWindow()) {
+      return win->GetExtantDoc();
+    }
+  }
+  return nullptr;
+}
