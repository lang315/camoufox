--- a/dom/base/WebRTCIPManager.cpp
+++ b/dom/base/WebRTCIPManager.cpp
@@ -52,7 +52,17 @@ WebRTCIPManager::SetIPv4(uint32_t userContextId, const nsAString& ipv4) {
 /* static */ bool
 WebRTCIPManager::GetIPv4(uint32_t userContextId, nsAString& outIPv4) {
   nsString key = IPv4KeyForUserContext(userContextId);
-  return RoverfoxStorageManager::GetString(key, outIPv4);
+  if (RoverfoxStorageManager::GetString(key, outIPv4) && !outIPv4.IsEmpty()) {
+    return true;
+  }
+  // The launch-level address (what geoip= sets) for a context that set none;
+  // without it the srflx candidate carried the real IP (#163). Not written
