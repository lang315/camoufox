+   * 0xfff8...), and the CRT's pow gives the x64 one.
    */
-  if (std::isfinite(x) && x != 0.0) {
+  if (std::isfinite(x) && x != 0.0 && !(x < 0 && UseUcrtMath())) {
     if (y == 0.5) {
       return jit::X86NaN(std::sqrt(x), x);
     }
@@ -633,6 +662,11 @@ double js::math_sin_fdlibm_impl(double x) {
 double js::math_sin_native_impl(double x) {
   MOZ_ASSERT(!math_use_fdlibm_for_sin_cos_tan());
   AutoUnsafeCallWithABI unsafe;
+#ifdef JS_UCRT_MATH
+  if (UseUcrtMath()) {
+    return jit::X86NaN(ucrt_sin(x), x);
+  }
+#endif
