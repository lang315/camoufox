ac_add_options --disable-update-agent
# ac_add_options --disable-alsa

# Disable --enable-bootstrap inherited from base.mozconfig. mach
# bootstrap on a non-Mozilla CI box fails fetching macOS toolchain
# artifacts; on a native macOS runner we have Xcode + brew tools
# already, so the bootstrap step is unnecessary.
ac_add_options --disable-bootstrap

# Bundled fonts.
#
# MOZ_BUNDLED_FONTS is what compiles in CoreTextFontList::ActivateBundledFonts(),
# the only caller of ActivateFontsFromDir() -- which is what registers
# <GRE>/fonts with CoreText via CTFontManagerRegisterFontURLs(). Without the
# define, that whole path is compiled out and the fonts we ship under
# Contents/Resources/fonts (Makefile passes `--fonts windows linux` for macOS)
# are never loaded, so a spoofed font list resolves against the host's own
# fonts instead of ours.
#
# Upstream's default is `target.os == "WINNT" or target.kernel == "Linux"`
# (toolkit/moz.configure), so Linux and Windows get this for free and macOS
# does not. settings/camoufox.cfg already sets
# `defaultPref("gfx.bundled-fonts.activate", 1)`, i.e. the pref side is on --
# only the build flag was missing.
ac_add_options --enable-bundled-fonts

# Packaging related
# #export DSYMUTIL="$MOZBUILD/clang/bin/dsymutil"
# export DMG_TOOL="$MOZBUILD/dmg/dmg"
# export HFS_TOOL="$MOZBUILD/dmg/hfsplus"

# Build related
# CROSS=$MOZBUILD
# CCTOOLS=$CROSS/cctools
# mk_add_options "export PATH=$MOZBUILD/clang/bin:$CCTOOLS/bin:$CROSS/binutils/bin:$CROSS/dmg:$PATH"
# mk_add_options "export LD_LIBRARY_PATH=$MOZBUILD/clang/lib:$CCTOOLS/lib"
# export CC="$CROSS/clang/bin/clang"
# export CXX="$CROSS/clang/bin/clang++"
# export HOST_CC="$CROSS/clang/bin/clang"
# export HOST_CXX="$CROSS/cla   ng/bin/clang++"

# Use the runner's preinstalled Xcode SDK so `./mach bootstrap` does not
# try to download MacOSX*.sdk from the Mozilla Taskcluster CDN (returns
# 403 for non-Mozilla CI). Required on GitHub macOS runners.
if command -v xcrun >/dev/null 2>&1; then
    ac_add_options --with-macos-sdk="$(xcrun --show-sdk-path)"
fi

# Firefox 146 requires clang >=17. Xcode 15 ships clang 16, so prefer
# the brew-installed LLVM toolchain when present (set via $MOZ_LLVM_PREFIX
# in the workflow). Falls back to Xcode's clang otherwise.
if [ -n "$MOZ_LLVM_PREFIX" ] && [ -x "$MOZ_LLVM_PREFIX/bin/clang" ]; then
    export CC="$MOZ_LLVM_PREFIX/bin/clang"
    export CXX="$MOZ_LLVM_PREFIX/bin/clang++"
fi

# WASI SDK is not preinstalled on the macOS runner. RLBox / wasm
# sandboxed libraries are not strictly required for Camoufox's
# automation purposes, so disable the sandbox to skip the wasi check.
ac_add_options --without-wasm-sandboxed-libraries
