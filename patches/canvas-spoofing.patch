       JS::Rooted<JS::Value> undef(cx, JS::UndefinedValue());
       JS_SetProperty(cx, global, "setFontSpacingSeed", undef);
       JS_DeleteProperty(cx, global, "setFontSpacingSeed");
+    }
+  }
+}
+
+void nsGlobalWindowInner::SetCanvasSeed(uint32_t seed, ErrorResult& aRv) {
+  uint32_t userContextId = 0;
+  if (BrowsingContext* bc = GetBrowsingContext()) {
+    userContextId = bc->OriginAttributesRef().mUserContextId;
+  }
+
+  CanvasSeedManager::SetSeed(userContextId, seed);
+
+  // Self-destruct so page JS can't detect the setter via typeof.
+  if (JSContext* cx = nsContentUtils::GetCurrentJSContext()) {
+    JS::Rooted<JSObject*> global(cx, JS::CurrentGlobalOrNull(cx));
+    if (global) {
+      JS::Rooted<JS::Value> undef(cx, JS::UndefinedValue());
+      JS_SetProperty(cx, global, "setCanvasSeed", undef);
+      JS_DeleteProperty(cx, global, "setCanvasSeed");
     }
   }
 }
