+uint32_t OffscreenCanvas::GetCanvasSeed() const {
+  // Main-thread case: walk to the owning document.
+  if (Document* doc = GetDocument()) {
+    return CanvasSeedManager::SeedFromDocument(doc);
+  }
+  // Worker case: pull userContextId from WorkerPrivate's origin attrs.
+  if (WorkerPrivate* wp = GetCurrentThreadWorkerPrivate()) {
+    return CanvasSeedManager::GetSeed(wp->GetOriginAttributes().mUserContextId);
+  }
+  return 0;
+}
+
 bool OffscreenCanvas::IsChrome() const {
   if (NS_IsMainThread()) {
     nsCOMPtr<nsPIDOMWindowInner> win = do_QueryInterface(GetOwnerGlobal());
@@ -780,6 +793,21 @@ already_AddRefed<Promise> OffscreenCanvas::ConvertToBlob(
   // existing encode path — between snapshot and ImageEncoder::ExtractData,
   // apply perturbation when GetCanvasSeed() != 0. Pattern identical to
   // HTMLCanvasElement::ExtractData above.
+  RefPtr<gfx::DataSourceSurface> dataSurface = snapshot
+      ? snapshot->GetDataSurface() : nullptr;
+  if (dataSurface) {
+    uint32_t seed = GetCanvasSeed();
+    if (seed != 0) {
+      gfx::DataSourceSurface::ScopedMap map(
+          dataSurface, gfx::DataSourceSurface::READ_WRITE);
+      if (map.IsMapped()) {
+        const gfx::IntSize size = dataSurface->GetSize();
+        const size_t len = static_cast<size_t>(map.GetStride()) * size.height;
+        CanvasSeedManager::Perturb(map.GetData(), len, seed,
+            CanvasSeedManager::GetNoiseDensity(),
+            CanvasSeedManager::GetNoiseStrength());
+      }
+    }
+  }
   return ImageEncoder::ExtractDataAsync(aType, aOptions, aUsingCustomOptions,
                                         dataSurface, encodeCompleteCallback);
 }
