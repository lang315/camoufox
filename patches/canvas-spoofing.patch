+#include "CanvasSeedManager.h"
+#include "nsPrintfCString.h"
+#include "MaskConfig.hpp"
+#include "nsGlobalWindowInner.h"
+#include "xpcpublic.h"
+#include "mozilla/dom/BrowsingContext.h"
+#include "mozilla/dom/Document.h"
+#include "nsDocShell.h"
+#include "nsPIDOMWindow.h"
+
+namespace mozilla {
+namespace dom {
+
+/* static */ nsString
+CanvasSeedManager::KeyForUserContext(uint32_t userContextId) {
+  nsString key;
+  key.AppendLiteral(u"canvas_seed_");
+  key.AppendInt(userContextId);
+  return key;
+}
+
+/* static */ nsString
+CanvasSeedManager::DisabledKeyForUserContext(uint32_t userContextId) {
+  nsString key;
+  key.AppendLiteral(u"canvas_seed_disabled_");
+  key.AppendInt(userContextId);
+  return key;
+}
+
+/* static */ void
+CanvasSeedManager::SetSeed(uint32_t userContextId, uint32_t seed) {
+  nsString key = KeyForUserContext(userContextId);
+  RoverfoxStorageManager::PutUint(key, seed);
+  DisableFunction(userContextId);
+}
+
+/* static */ uint32_t
+CanvasSeedManager::GetSeed(uint32_t userContextId) {
+  nsString key = KeyForUserContext(userContextId);
+  uint32_t seed = 0;
+  if (RoverfoxStorageManager::GetUint(key, seed) && seed != 0) {
+    return seed;
+  }
+  // Fallback to CAMOU_CONFIG so worker processes pick up the seed.
+  if (auto val = MaskConfig::GetUint32("canvas:seed")) {
+    return val.value();
+  }
+  return 0;
+}
+
+/* static */ bool
+CanvasSeedManager::HasSeed(uint32_t userContextId) {
+  nsString key = KeyForUserContext(userContextId);
+  uint32_t seed = 0;
+  return RoverfoxStorageManager::GetUint(key, seed);
+}
+
+/* static */ bool
+CanvasSeedManager::IsFunctionDisabled(uint32_t userContextId) {
+  nsString key = DisabledKeyForUserContext(userContextId);
+  bool disabled = false;
+  return RoverfoxStorageManager::GetBool(key, disabled) && disabled;
+}
+
+/* static */ void
+CanvasSeedManager::DisableFunction(uint32_t userContextId) {
+  nsString key = DisabledKeyForUserContext(userContextId);
+  RoverfoxStorageManager::PutBool(key, true);
+}
+
+/* static */ bool
+CanvasSeedManager::IsFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj) {
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aObj);
+  if (!win) {
+    return false;
+  }
+  uint32_t userContextId = 0;
+  if (BrowsingContext* bc = win->GetBrowsingContext()) {
+    userContextId = bc->OriginAttributesRef().mUserContextId;
+  }
+  bool disabled = false;
+  RoverfoxStorageManager::GetBool(DisabledKeyForUserContext(userContextId), disabled);
+  return !disabled;
+}
+
+// xxhash32 of the first kHashBytes of buf (or the whole buf if smaller).
+// Mixes content into the per-context seed so identical canvases on
+// different contexts diverge AND so resizing the same drawing keeps
+// the noise pattern coherent.
+static uint32_t HashContent(const uint8_t* buf, size_t len) {
+  constexpr size_t kHashBytes = 1024;
+  const size_t n = (len < kHashBytes) ? len : kHashBytes;
+  uint32_t h = 0x811C9DC5u;            // FNV-1a 32-bit
+  for (size_t i = 0; i < n; ++i) {
+    h ^= buf[i];
+    h *= 0x01000193u;
+  }
+  return h;
+}
+
+/* static */ void
+CanvasSeedManager::Perturb(uint8_t* data, size_t length,
+                           uint32_t seed, double density, uint32_t strength) {
+  if (seed == 0 || data == nullptr || length < 4 || density <= 0.0) {
+    return;
+  }
+  // Mix seed with content. Keeps noise deterministic per (seed, content).
+  uint32_t s = seed ^ HashContent(data, length);
+  if (s == 0) {
+    s = seed | 1u;
+  }
+  // LCG matches FontSpacingSeedManager / gfxHarfBuzzShaper.
+  const uint32_t kThreshold = static_cast<uint32_t>(density * 4294967296.0);
+  for (size_t i = 0; i < length; ++i) {
+    if ((i & 3u) == 3u) {
+      continue;  // skip alpha channel
+    }
+    s = s * 1103515245u + 12345u;
+    if (s < kThreshold) {
+      int32_t delta = ((s >> 16) & 1u) ? +static_cast<int32_t>(strength)
+                                       : -static_cast<int32_t>(strength);
+      int32_t v = static_cast<int32_t>(data[i]) + delta;
+      if (v < 0) v = 0;
+      else if (v > 255) v = 255;
+      data[i] = static_cast<uint8_t>(v);
+    }
+  }
+}
+
+/* static */ double
+CanvasSeedManager::GetNoiseDensity() {
+  if (auto v = MaskConfig::GetDouble("canvas:noiseDensity")) {
+    return v.value();
+  }
+  return 0.0005;  // 1 in 2000 channels
+}
+
+/* static */ uint32_t
+CanvasSeedManager::GetNoiseStrength() {
+  if (auto v = MaskConfig::GetUint32("canvas:noiseStrength")) {
+    return v.value();
+  }
+  return 1;  // ±1 LSB
+}
+
+/* static */ uint32_t
+CanvasSeedManager::SeedFromWindow(nsPIDOMWindowInner* aWin) {
+  if (!aWin) return 0;
+  if (BrowsingContext* bc = aWin->GetBrowsingContext()) {
+    return GetSeed(bc->OriginAttributesRef().mUserContextId);
+  }
+  return 0;
+}
+
+/* static */ uint32_t
+CanvasSeedManager::SeedFromDocument(Document* aDoc) {
+  if (!aDoc) return 0;
+  return SeedFromWindow(aDoc->GetInnerWindow());
+}
+
+} // namespace dom
+} // namespace mozilla
