     const MediaDecodingConfiguration& aConfiguration, ErrorResult& aRv,
     Promise* aPromise, const mediacaps::BehaviorConfig& aBehavior) {
   LOG("Processing {}", aConfiguration);
+  // camoufox: if the queried content type matches the per-OS codec config,
+  // resolve with spoofed support/smooth/powerEfficient so a cross-OS profile
+  // presents a coherent codec + HW-decode matrix (coherent with canPlayType)
+  // instead of leaking the host capabilities (#6). EME queries
+  // (keySystemConfiguration) fall through to the real resolver so the
+  // returned mediaKeySystemAccess stays correct and coherent.
+  if (!aConfiguration.mKeySystemConfiguration.WasPassed()) {
+    nsAutoCString ctype;
+    if (aConfiguration.mVideo.WasPassed()) {
+      ctype = NS_ConvertUTF16toUTF8(aConfiguration.mVideo.Value().mContentType);
+    } else if (aConfiguration.mAudio.WasPassed()) {
+      ctype = NS_ConvertUTF16toUTF8(aConfiguration.mAudio.Value().mContentType);
+    }
+    bool sup = true, smooth = true, power = false;
+    if (!ctype.IsEmpty() &&
+        MaskConfig::GetMediaDecodingInfo(ctype.get(), sup, smooth, power)) {
+      MediaCapabilitiesDecodingInfo info;
+      info.mSupported = sup;
+      info.mSmooth = sup && smooth;
+      info.mPowerEfficient = sup && power;
+      aPromise->MaybeResolve(std::move(info));
+      return;
+    }
+  }
+

   const bool isWebRTC =
       mediacaps::IsMediaTypeWebRTC(AsVariant(aConfiguration.mType));
