+// Camoufox: per-context font visibility (#44).
+//
+// This answers ONLY the per-context question: a context that installed a
+// font list of its own through setFontList() is limited to that list. Every
+// other caller -- the default context, chrome, an internal lookup with no
+// provider -- is not filtered here. The launch-level "fonts" key is
+// enforced by MaskedFontListBlocks() / MaskConfig::IsFontAllowed() at the
+// sites that carry a FontVisibilityProvider, which is what keeps the chrome
+// exemption (daijro/camoufox#695) in exactly one place.
+//
+// Known limitation (CLAUDE.md lesson 5): when the context id resolves to 0
+// because the provider chain failed, this gate fails open. It is stated in
+// the PR rather than fixed here.
+static bool CamouIsFontAllowed(const nsACString& aLowerKey) {
+  uint32_t ctx = mozilla::dom::FontListManager::GetCurrentContext();
+  bool hasList = ctx != 0 && mozilla::dom::FontListManager::HasFontList(ctx);
+  bool allowed =
+      !hasList || mozilla::dom::FontListManager::IsFontAllowed(ctx, aLowerKey);
+  // Camoufox (#83) diagnostic. Arm (b2r) of the Phase B smoke refuted H1 --
+  // the list being installed in a process that does not render -- and the
+  // second context then reproduced the FIRST context's allow/deny pattern
+  // exactly, which neither "allow everything" nor a normal per-context answer
+  // predicts. This line says which context id the gate actually saw while
+  // that happened. MOZ_LOG evaluates its arguments only when the module is
+  // enabled, so the flat-string copy costs nothing with fontlist off; read
+  // with MOZ_LOG=fontlist:5.
+  LOG_FONTLIST(("CAMOU-FL gate ctx=%u hasList=%d key=%s allowed=%d main=%d",
+                ctx, hasList ? 1 : 0, nsPromiseFlatCString(aLowerKey).get(),
+                allowed ? 1 : 0, NS_IsMainThread() ? 1 : 0));
+  return allowed;
+}
