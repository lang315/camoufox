@@ -0,0 +1,127 @@
+/* Camoufox: Per-context font list manager */
+#include "FontListManager.h"
+
+#include "gfxPlatformFontList.h"
+#include "mozilla/Logging.h"
+#include "mozilla/Mutex.h"
+#include "mozilla/dom/BrowsingContext.h"
+#include "nsGlobalWindowInner.h"
+#include "nsThreadUtils.h"
+#include "xpcpublic.h"
+
+namespace mozilla {
+namespace dom {
+
+static Mutex sFontListMutex("FontListManager");
+static nsTHashMap<nsUint32HashKey, nsTHashSet<nsCString>> sFontLists;
+static thread_local uint32_t sCurrentContextId = 0;
+
+// Camoufox (#83) diagnostic. LazyLogModule resolves by NAME, so this is the
+// same "fontlist" module gfxPlatformFontList.cpp's LOG_FONTLIST macro writes
+// to and one MOZ_LOG=fontlist:5 covers both files. MOZ_LOG evaluates its
+// arguments only when the module is enabled, so these lines are free when it
+// is off.
+static mozilla::LazyLogModule sCamouFontListLog("fontlist");
+#define CAMOU_LOG_FL(args) \
+  MOZ_LOG(sCamouFontListLog, mozilla::LogLevel::Debug, args)
+
+nsString FontListManager::DisabledKeyForUserContext(uint32_t aId) {
+  nsAutoString key;
+  key.AppendPrintf("fontlist_d_%u", aId);
+  return key;
+}
+
+void FontListManager::SetFontList(uint32_t aId, const nsAString& aFontList) {
+  nsTHashSet<nsCString> fontSet;
+  nsAutoString remaining(aFontList);
+  while (!remaining.IsEmpty()) {
+    int32_t commaPos = remaining.FindChar(',');
+    nsAutoString fontName;
+    if (commaPos >= 0) {
+      fontName = Substring(remaining, 0, commaPos);
+      remaining.Cut(0, commaPos + 1);
+    } else {
+      fontName = remaining;
+      remaining.Truncate();
+    }
+    fontName.Trim(" \t");
+    if (fontName.IsEmpty()) continue;
+    nsAutoCString utf8;
+    CopyUTF16toUTF8(fontName, utf8);
+    ToLowerCase(utf8);
+    fontSet.Insert(utf8);
+  }
+  const uint32_t camouCount = fontSet.Count();
+  {
+    MutexAutoLock lock(sFontListMutex);
+    sFontLists.InsertOrUpdate(aId, std::move(fontSet));
+  }
+  // Camoufox (#83) diagnostic: which context installed a list, how many
+  // families it carries, and -- through MOZ_LOG's own process tagging -- in
+  // which process. There is no removal or clear entry point for context close,
+  // so an install is the only lifetime event this class has to log.
+  CAMOU_LOG_FL(("CAMOU-FL set ctx=%u n=%u", aId, camouCount));
+  // #81: a context installing its own font list invalidates the
+  // process-wide "no font covers this codepoint" cache -- a codepoint
+  // this context's own list can now serve must not still be answered
+  // by an earlier context's stale miss. Deliberately outside
+  // sFontListMutex: ClearCodepointsWithNoFonts() takes
+  // gfxPlatformFontList::mLock, and every gated read path acquires mLock
+  // before sFontListMutex, so holding both here in the other order would
+  // be a lock-order inversion.
+  gfxPlatformFontList::PlatformFontList()->ClearCodepointsWithNoFonts();
+  // #83: same invalidation, same lock order, for the name-keyed memos that
+  // sit in front of the gate. Their entries are keyed by context, so this
+  // context's own pre-install answers -- taken when it had no list and the
+  // gate let everything through -- are the ones that must go.
+  gfxPlatformFontList::PlatformFontList()->ClearFontNameCaches();
+}
+
+bool FontListManager::HasFontList(uint32_t aId) {
+  MutexAutoLock lock(sFontListMutex);
+  return sFontLists.Contains(aId);
+}
+
+bool FontListManager::IsFontAllowed(uint32_t aId,
+                                     const nsACString& aFontName) {
+  MutexAutoLock lock(sFontListMutex);
+  auto entry = sFontLists.Lookup(aId);
+  if (!entry) return true;
+  return entry.Data().Contains(aFontName);
+}
+
+void FontListManager::SetCurrentContext(uint32_t aId) {
+  // Camoufox (#83) diagnostic: a scope opening on one context while another
+  // context's scope is already active on this thread should be impossible --
+  // AutoFontListContext saves the old id and restores it. If this line ever
+  // prints, that is itself the finding.
+  if (sCurrentContextId != 0 && aId != 0 && sCurrentContextId != aId) {
+    CAMOU_LOG_FL(("CAMOU-FL scope-switch from=%u to=%u main=%d",
+                  sCurrentContextId, aId, NS_IsMainThread() ? 1 : 0));
+  }
+  sCurrentContextId = aId;
+}
+
+uint32_t FontListManager::GetCurrentContext() {
+  return sCurrentContextId;
+}
+
+void FontListManager::DisableFunction(uint32_t aId) {
+  RoverfoxStorageManager::PutBool(DisabledKeyForUserContext(aId), true);
+}
+
+bool FontListManager::IsFunctionEnabledForWebIDL(JSContext* aCx,
+                                                  JSObject* aObj) {
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aObj);
+  if (!win) return false;
+  uint32_t id = 0;
+  if (BrowsingContext* bc = win->GetBrowsingContext()) {
+    id = bc->OriginAttributesRef().mUserContextId;
+  }
+  bool disabled = false;
+  RoverfoxStorageManager::GetBool(DisabledKeyForUserContext(id), disabled);
+  return !disabled;
+}
+
+}  // namespace dom
+}  // namespace mozilla
