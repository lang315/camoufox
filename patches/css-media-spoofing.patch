 StyleColorGamut Gecko_MediaFeatures_ColorGamut(const Document* aDocument) {
+  // camoufox: spoof the output-device color gamut so a wide-gamut (P3/
+  // Rec2020) monitor is not a fingerprint; goapi defaults this to srgb. (#8)
+  if (auto v = MaskConfig::GetString("cssMedia:colorGamut")) {
+    if (*v == "p3") return StyleColorGamut::P3;
+    if (*v == "rec2020") return StyleColorGamut::Rec2020;
+    return StyleColorGamut::Srgb;
+  }
