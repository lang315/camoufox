-#  define acceptableUCS4Encoding(p, e, k) \
-    ((p) == PLATFORM_ID_MICROSOFT && (e) == EncodingIDUCS4ForMicrosoftPlatform)
+// Camoufox: a Unicode-platform UCS4 subtable is accepted as a LAST RESORT.
+// Upstream's non-macOS branch takes format 10/12/13 only at (3, 10), so a
+// face whose only subtable is (0, 3) or (0, 4) -- Geneva, Apple Symbols,
+// .LastResort, Heiti TC/SC, all shipped in bundle/fonts/macos/ -- gets
+// keepFormat 0, ReadCMAP returns NS_ERROR_FAILURE, and the font entry is
+// given an EMPTY character map: listed in the font list, never selected for
+// any text run. A macOS build already accepts these (the XP_MACOSX branch
+// above), which is why real macOS renders Geneva and a spoofed macOS profile
+// on a Linux or Windows build does not -- a fingerprinting tell. See #95.
+//
+// The `!(k)` term is what bounds this: the clause only fires when nothing
+// else has been accepted yet, so every font that resolves today keeps the
+// subtable it resolves through and is unaffected.
+#  define acceptableUCS4Encoding(p, e, k)                       \
+    (((p) == PLATFORM_ID_MICROSOFT &&                           \
+      (e) == EncodingIDUCS4ForMicrosoftPlatform) ||             \
+     ((p) == PLATFORM_ID_UNICODE &&                             \
+      (e) != EncodingIDUVSForUnicodePlatform && !(k)))
 #endif
 
 #define acceptablePlatform(p) \
