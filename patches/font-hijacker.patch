+// Helper function to check if a font is in the allowed list
+inline bool IsFontAllowed(const nsACString& aFontName) {
+  // Per-context list first (#44): a context that installed a list of its
+  // own through setFontList() is limited to it. The launch-level allowlist
+  // still applies on top -- the two intersect here exactly as they do on
+  // every C++ read path (MaskedFontListBlocks, then CamouIsFontAllowed), so
+  // document.fonts cannot report a face that text rendering will refuse.
+  if (uint32_t ctx = FontListManager::GetCurrentContext();
+      ctx != 0 && FontListManager::HasFontList(ctx)) {
+    nsAutoCString key(aFontName);
+    ToLowerCase(key);
+    if (!FontListManager::IsFontAllowed(ctx, key)) {
+      return false;
+    }
+  }
+  std::string fontName(aFontName.BeginReading(), aFontName.Length());
+  std::transform(fontName.begin(), fontName.end(), fontName.begin(),
+                 [](unsigned char c) { return std::tolower(c); });
+  return MaskConfig::IsFontAllowed(fontName);
+}
