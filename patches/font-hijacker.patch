+// Camoufox: the user context this FontFace belongs to, or 0 when it has no
+// inner window (a worker global, or a detached document). Derived exactly the
+// way FontFaceSet.cpp derives it for its own entry points, and the way
+// nsGlobalWindowInner::SetFontList() keyed the list when it stored it.
+static uint32_t CamouFontListContextId(nsIGlobalObject* aGlobal) {
+  if (!aGlobal) {
+    return 0;
+  }
+  nsPIDOMWindowInner* inner = aGlobal->GetAsInnerWindow();
+  if (!inner) {
+    return 0;
+  }
+  BrowsingContext* bc = inner->GetBrowsingContext();
+  return bc ? bc->OriginAttributesRef().mUserContextId : 0;
+}
+
+FontFaceLoadStatus FontFace::Status() {
+  // Nothing scopes a context for a bare FontFace -- one the page never handed
+  // to a FontFaceSet -- so IsFontAllowed() fell back to the launch-level
+  // "fonts" key here in every context. Under a Windows launch a macOS context
+  // reported 'loaded' for Segoe UI and 'error' for Helvetica Neue while canvas
+  // text measurement in that same context said the exact opposite (#44).
+  AutoFontListContext autoFontListCtx(
+      CamouFontListContextId(GetParentObject()));
+
+  nsAutoCString fontFamily;
+  GetFamily(fontFamily);
+
+  if (mozilla::dom::IsFontAllowed(fontFamily)) {
+    return FontFaceLoadStatus::Loaded;
+  } else {
+    return FontFaceLoadStatus::Error;
+  }
+}
 
