+bool isLinkLocalIPv6(const std::string& ip) {
+  // fe80::/10 - first 10 bits = 1111111010. Firefox normally hands us
+  // lowercase canonical IPv6, but we accept uppercase defensively so a
+  // non-normalized candidate cannot slip a host address through.
+  return ip.length() >= 4 &&
+         (ip[0] == 'f' || ip[0] == 'F') &&
+         (ip[1] == 'e' || ip[1] == 'E') &&
+         (ip[2] == '8' || ip[2] == '9' ||
+          ip[2] == 'a' || ip[2] == 'A' ||
+          ip[2] == 'b' || ip[2] == 'B');
+}
+
+// Per-context-stable fabricated link-local. Same userContextId ->
+// same address. Different userContextId -> different address.
+std::string FabricateLinkLocalIPv6(uint32_t userContextId) {
+  uint64_t h = mozilla::HashGeneric(userContextId, 0xDEADBEEFu);
+  char buf[40];
+  snprintf(buf, sizeof(buf), "fe80::%04x:%04x:%04x:%04x",
+           static_cast<unsigned>((h >> 48) & 0xFFFF),
+           static_cast<unsigned>((h >> 32) & 0xFFFF),
+           static_cast<unsigned>((h >> 16) & 0xFFFF),
+           static_cast<unsigned>(h & 0xFFFF));
+  return std::string(buf);
 }
 
