-      return NS_ConvertUTF16toUTF8(ipv6Value).get();
+  // Prefer the configured LOCAL address for RFC1918 / ULA candidates, else the
+  // public spoof. Fetch only the family actually returned, so each candidate
+  // does at most one storage lookup instead of four.
+  const bool isLocal = isPrivateIP(ip);
+  nsString value;
+  if (isIPv6) {
+    if (isLocal && WebRTCIPManager::GetLocalIPv6(userContextId, value)) {
+      return NS_ConvertUTF16toUTF8(value).get();
+    }
+    if (WebRTCIPManager::GetIPv6(userContextId, value)) {
+      return NS_ConvertUTF16toUTF8(value).get();
     }
   } else {
-    if (hasIPv4) {
-      return NS_ConvertUTF16toUTF8(ipv4Value).get();
+    if (isLocal && WebRTCIPManager::GetLocalIPv4(userContextId, value)) {
+      return NS_ConvertUTF16toUTF8(value).get();
     }
+    if (WebRTCIPManager::GetIPv4(userContextId, value)) {
+      return NS_ConvertUTF16toUTF8(value).get();
+    }
   }
   // return original ip if no mask is available
   return ip;
