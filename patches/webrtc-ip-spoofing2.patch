 }

+/* static */ bool WebRTCIPManager::GetLocalIPv4(uint32_t userContextId,
+                                                nsAString& out) {
+  nsString key;
+  key.AppendLiteral(u"webrtc_localipv4_");
+  key.AppendInt(userContextId);
+  nsCString val;
+  if (!RoverfoxStorageManager::GetString(key, val)) {
+    if (auto v = MaskConfig::GetString("webrtc:localipv4")) {
+      out.AssignASCII(v.value().c_str());
+      return !out.IsEmpty();
+    }
+    return false;
+  }
+  CopyUTF8toUTF16(val, out);
+  return true;
+}
+
+/* static */ void WebRTCIPManager::SetLocalIPv4(uint32_t userContextId,
+                                                const nsAString& ipv4) {
+  nsString key;
+  key.AppendLiteral(u"webrtc_localipv4_");
+  key.AppendInt(userContextId);
+  RoverfoxStorageManager::PutString(key, NS_ConvertUTF16toUTF8(ipv4));
+}
+
+/* static */ bool WebRTCIPManager::GetLocalIPv6(uint32_t userContextId,
+                                                nsAString& out) {
+  nsString key;
+  key.AppendLiteral(u"webrtc_localipv6_");
+  key.AppendInt(userContextId);
+  nsCString val;
+  if (!RoverfoxStorageManager::GetString(key, val)) {
+    if (auto v = MaskConfig::GetString("webrtc:localipv6")) {
+      out.AssignASCII(v.value().c_str());
+      return !out.IsEmpty();
+    }
+    return false;
+  }
+  CopyUTF8toUTF16(val, out);
+  return true;
+}
+
+/* static */ void WebRTCIPManager::SetLocalIPv6(uint32_t userContextId,
+                                                const nsAString& ipv6) {
+  nsString key;
+  key.AppendLiteral(u"webrtc_localipv6_");
+  key.AppendInt(userContextId);
+  RoverfoxStorageManager::PutString(key, NS_ConvertUTF16toUTF8(ipv6));
+}
