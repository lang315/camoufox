new file mode 100644
index 0000000000..77b064b13c
--- /dev/null
+++ b/dom/base/ScreenDimensionManager.h
@@ -0,0 +1,89 @@
+/* Camoufox: Per-context screen dimension manager */
+#ifndef mozilla_dom_ScreenDimensionManager_h
+#define mozilla_dom_ScreenDimensionManager_h
+
+#include "RoverfoxStorageManager.h"
+#include "nsString.h"
+
+namespace mozilla {
+namespace dom {
+
+// Per-context screen geometry, keyed by userContextId, stored through
+// RoverfoxStorageManager so the value survives the content-process boundary the
+// same way NavigatorManager's does.
+//
+// Width and height are stored as one pair and gated by one "disabled" flag:
+// setScreenDimensions() takes both at once, so there is no state in which only
+// one of them has been set. colorDepth is independent -- setScreenColorDepth()
+// is a separate call and self-destructs separately.
+class ScreenDimensionManager {
+ public:
+  static void SetDimensions(uint32_t aId, uint32_t aWidth, uint32_t aHeight) {
+    nsAutoString wKey;
+    wKey.AppendPrintf("scr_w_%u", aId);
+    RoverfoxStorageManager::PutUint(wKey, aWidth);
+    nsAutoString hKey;
+    hKey.AppendPrintf("scr_h_%u", aId);
+    RoverfoxStorageManager::PutUint(hKey, aHeight);
+    nsAutoString dKey;
+    dKey.AppendPrintf("scr_dim_d_%u", aId);
+    RoverfoxStorageManager::PutBool(dKey, true);
+  }
+
+  static bool GetDimensions(uint32_t aId, uint32_t& aWidth, uint32_t& aHeight) {
+    nsAutoString wKey;
+    wKey.AppendPrintf("scr_w_%u", aId);
+    nsAutoString hKey;
+    hKey.AppendPrintf("scr_h_%u", aId);
+    // Both or neither: a half-applied size is a worse lie than no lie at all,
+    // since screen.width and screen.height would come from different displays.
+    uint32_t width = 0;
+    uint32_t height = 0;
+    if (!RoverfoxStorageManager::GetUint(wKey, width) ||
+        !RoverfoxStorageManager::GetUint(hKey, height)) {
+      return false;
+    }
+    if (!width || !height) {
+      return false;
+    }
+    aWidth = width;
+    aHeight = height;
+    return true;
+  }
+
+  static void SetColorDepth(uint32_t aId, uint32_t aDepth) {
+    nsAutoString key;
+    key.AppendPrintf("scr_depth_%u", aId);
+    RoverfoxStorageManager::PutUint(key, aDepth);
+    nsAutoString dKey;
+    dKey.AppendPrintf("scr_depth_d_%u", aId);
+    RoverfoxStorageManager::PutBool(dKey, true);
+  }
+
+  static bool GetColorDepth(uint32_t aId, uint32_t& aDepth) {
+    nsAutoString key;
+    key.AppendPrintf("scr_depth_%u", aId);
+    uint32_t depth = 0;
+    if (!RoverfoxStorageManager::GetUint(key, depth) || !depth) {
+      return false;
+    }
+    aDepth = depth;
+    return true;
+  }
+
+  // WebIDL Func= gates. Each returns false once the matching setter has run,
+  // which is what removes the function from the page's view of window.
+  static bool IsDimensionsFunctionEnabledForWebIDL(JSContext* aCx,
+                                                   JSObject* aObj);
+  static bool IsColorDepthFunctionEnabledForWebIDL(JSContext* aCx,
+                                                   JSObject* aObj);
+
+  // Disable a setter without calling it (#57).
+  static void DisableDimensionsFunction(uint32_t aId);
+  static void DisableColorDepthFunction(uint32_t aId);
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_ScreenDimensionManager_h
