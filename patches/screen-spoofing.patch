+void nsGlobalWindowInner::SetScreenDimensions(uint32_t width, uint32_t height,
+                                              ErrorResult& aRv) {
+  if (!width || !height) {
+    aRv.ThrowTypeError("Screen dimensions must be non-zero");
+    return;
+  }
+  uint32_t userContextId = 0;
+  if (BrowsingContext* bc = GetBrowsingContext()) {
+    userContextId = bc->OriginAttributesRef().mUserContextId;
+  }
+  ScreenDimensionManager::SetDimensions(userContextId, width, height);
+  if (userContextId != 0) {
+    ScreenDimensionManager::SetDimensions(0, width, height);
+  }
+  // Self-destruct: set to undefined first to bust IC/shape caches on ARM64.
+  if (JSContext* cx = nsContentUtils::GetCurrentJSContext()) {
+    JS::Rooted<JSObject*> global(cx, JS::CurrentGlobalOrNull(cx));
+    if (global) {
+      JS::Rooted<JS::Value> undef(cx, JS::UndefinedValue());
+      JS_SetProperty(cx, global, "setScreenDimensions", undef);
+      JS_DeleteProperty(cx, global, "setScreenDimensions");
+    }
+  }
+}
+
+void nsGlobalWindowInner::SetScreenColorDepth(uint32_t depth,
+                                              ErrorResult& aRv) {
+  if (!depth) {
+    aRv.ThrowTypeError("Screen colour depth must be non-zero");
+    return;
+  }
+  uint32_t userContextId = 0;
+  if (BrowsingContext* bc = GetBrowsingContext()) {
+    userContextId = bc->OriginAttributesRef().mUserContextId;
+  }
+  ScreenDimensionManager::SetColorDepth(userContextId, depth);
+  if (userContextId != 0) {
+    ScreenDimensionManager::SetColorDepth(0, depth);
+  }
+  // Self-destruct: set to undefined first to bust IC/shape caches on ARM64.
+  if (JSContext* cx = nsContentUtils::GetCurrentJSContext()) {
+    JS::Rooted<JSObject*> global(cx, JS::CurrentGlobalOrNull(cx));
+    if (global) {
+      JS::Rooted<JS::Value> undef(cx, JS::UndefinedValue());
+      JS_SetProperty(cx, global, "setScreenColorDepth", undef);
+      JS_DeleteProperty(cx, global, "setScreenColorDepth");
+    }
+  }
+}
