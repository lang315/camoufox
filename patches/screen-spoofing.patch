+/* Camoufox: Per-context screen dimension manager */
+#include "ScreenDimensionManager.h"
+
+#include "mozilla/dom/BrowsingContext.h"
+#include "nsGlobalWindowInner.h"
+#include "nsPIDOMWindowInlines.h"
+#include "xpcpublic.h"
+
+namespace mozilla {
+namespace dom {
+
+static uint32_t UserContextIdFor(JSObject* aObj) {
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aObj);
+  if (!win) return 0;
+  if (BrowsingContext* bc = win->GetBrowsingContext()) {
+    return bc->OriginAttributesRef().mUserContextId;
+  }
+  return 0;
+}
+
+static bool IsDisabled(const char* aPrefix, uint32_t aId) {
+  nsAutoString dKey;
+  dKey.AppendPrintf("%s_d_%u", aPrefix, aId);
+  bool disabled = false;
+  RoverfoxStorageManager::GetBool(dKey, disabled);
+  return disabled;
+}
+
+// Camoufox (#57): hide a setter without calling it.
+static void SetDisabled(const char* aPrefix, uint32_t aId) {
+  nsAutoString dKey;
+  dKey.AppendPrintf("%s_d_%u", aPrefix, aId);
+  RoverfoxStorageManager::PutBool(dKey, true);
+}
+
+/* static */ void ScreenDimensionManager::DisableDimensionsFunction(
+    uint32_t aId) {
+  SetDisabled("scr_dim", aId);
+}
+
+/* static */ void ScreenDimensionManager::DisableColorDepthFunction(
+    uint32_t aId) {
+  SetDisabled("scr_depth", aId);
+}
+
+/* static */
+bool ScreenDimensionManager::IsDimensionsFunctionEnabledForWebIDL(
+    JSContext* aCx, JSObject* aObj) {
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aObj);
+  if (!win) return false;
+  return !IsDisabled("scr_dim", UserContextIdFor(aObj));
+}
+
+/* static */
+bool ScreenDimensionManager::IsColorDepthFunctionEnabledForWebIDL(
+    JSContext* aCx, JSObject* aObj) {
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aObj);
+  if (!win) return false;
+  return !IsDisabled("scr_depth", UserContextIdFor(aObj));
+}
+
+}  // namespace dom
+}  // namespace mozilla
